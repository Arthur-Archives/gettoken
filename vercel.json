{
  "version": 2,
  "regions": ["iad1"],
  "redirects": [
    {
      "source": "/((?!pandora/gettoken|spotify/gettoken).*)",
      "destination": "https://adssousag.is-a.dev/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/pandora/gettoken", "destination": "/api/gettoken.js" },
    { "source": "/spotify/gettoken", "destination": "/api/spotify.js" }
  ],
  "functions": {
    "api/spotify.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
